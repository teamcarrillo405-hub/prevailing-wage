# ============================================================
# Prevailing Wage — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in all required values.
# Run 'node scripts/generate-secrets.js' (or: npm run generate-secrets)
# to generate JWT_SECRET and ENCRYPTION_KEY_V1.
#
# NEVER commit your .env file. It is listed in .gitignore.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Path to the SQLite database file.
# Can be absolute or relative to the project root.
# Required.
DATABASE_PATH=./data/prevailing-wage.db

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# Port the Express API listens on.
# Default: 3001 (or 4099 locally to avoid conflicts with other apps).
# Optional — falls back to 3001 if unset.
PORT=4099

# Runtime environment. Controls cookie security flags, static-file serving, etc.
# Valid values: development | production | test
# Required.
NODE_ENV=development

# Frontend origin allowed for CORS and double-submit cookie checks.
# Set to your Vite dev server URL locally, and your production domain in prod.
# Required.
CORS_ORIGIN=http://localhost:4200

# Public-facing base URL of the app (used in email links and invite URLs).
# No trailing slash.
# Optional — falls back to http://localhost:3000 if unset.
APP_URL=http://localhost:4200

# Directory where multer stores uploaded subcontractor files.
# Can be relative to the project root or an absolute path.
# Optional — falls back to ./uploads if unset.
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# Security — run 'node scripts/generate-secrets.js' to generate
# ------------------------------------------------------------

# JWT signing secret for session tokens.
# Required. Minimum 32 characters. Use a random base64url string.
# Generate: node scripts/generate-secrets.js
JWT_SECRET=

# AES-256-GCM key used to encrypt SSNs at rest (cryptoService.ts).
# Required. Exactly 64 hexadecimal characters (32 bytes).
# Generate: node scripts/generate-secrets.js
# WARNING: Changing this key makes all existing encrypted SSN records unreadable.
ENCRYPTION_KEY_V1=

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------

# If set, new user registration requires this exact code.
# Leave blank to allow open registration.
# Optional.
INVITE_CODE=

# ------------------------------------------------------------
# Email — transport priority: SMTP → Resend → silent skip
# ------------------------------------------------------------

# Google Workspace (or any SMTP) — primary transport.
# Set all three (HOST + USER + PASS) to activate. If unset, falls back to Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                          # true for port 465
SMTP_USER=noreply@averopw.com              # your Google Workspace sending address
SMTP_PASS=                                 # Google Workspace App Password (16-char)
SMTP_FROM=AVERO Prevailing Wage <noreply@averopw.com>

# Resend fallback — only used if SMTP_HOST/USER/PASS are all unset.
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=

# Support inbox that receives forwarded contact form submissions.
# Optional — falls back to support@averopw.com if unset.
EMAIL_SUPPORT=support@averopw.com

# ------------------------------------------------------------
# Billing (Stripe — stripe.com)
# ------------------------------------------------------------

# Stripe secret key. Required for billing/subscription features.
# Use sk_test_... for development, sk_live_... for production.
# Optional — billing routes will throw if unset and called.
STRIPE_SECRET_KEY=

# Stripe webhook endpoint secret for verifying /api/billing/webhook payloads.
# Obtain by running: stripe listen --forward-to localhost:4099/api/billing/webhook
# Required if receiving Stripe webhook events.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for subscription plans.
# Create these in your Stripe Dashboard under Products → Prices.
# Required for billing to work — checkout returns 503 STRIPE_NOT_CONFIGURED if unset.
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PRO=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ENTERPRISE=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Error Monitoring (Sentry — sentry.io)
# ------------------------------------------------------------

# Sentry DSN for server-side error reporting.
# Obtain from: https://sentry.io → your project → Settings → Client Keys.
# Optional — errors are only logged to console if unset.
SENTRY_DSN=

# ------------------------------------------------------------
# Logging (Better Stack / Logtail — betterstack.com)
# ------------------------------------------------------------

# Source token for piping Pino logs to Better Stack (Logtail).
# Obtain from: https://logs.betterstack.com -> Sources -> your source -> Source Token
# Some Better Stack dashboards label this BETTERSTACK_TOKEN — same value.
# Optional — startup warns if unset; logs stay on stdout (Render captures them).
LOGTAIL_TOKEN=

# ------------------------------------------------------------
# External APIs
# ------------------------------------------------------------

# ------------------------------------------------------------
# PrevWage Copilot (Anthropic Claude)
# ------------------------------------------------------------
# Optional. If unset, Copilot uses the local rules engine and still records
# advisory audit history. Set for Claude-powered page-aware guidance.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------
# SAM.gov API key
# ------------------------------------------------------------
# Required for rate-limit exemption on WDOL wage determination downloads.
# Obtain a free System Account key at https://open.gsa.gov/api/sam/ under "Get an API Key".
# The WDOL v1 endpoint works without a key but hits strict rate limits under load.
# SAMGOV_API_KEY is the Phase 88 canonical name; SAM_GOV_API_KEY retained for legacy compat.
SAMGOV_API_KEY=
SAM_GOV_API_KEY=

# ------------------------------------------------------------
# QuickBooks Online OAuth
# ------------------------------------------------------------
# Required for live QuickBooks payroll/time import testing.
# Callback URL in Intuit must match QBO_REDIRECT_URI exactly.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:4099/api/integrations/qbo/callback

# ------------------------------------------------------------
# Procore OAuth
# ------------------------------------------------------------
# Optional for launch demo unless showing Procore import.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_REDIRECT_URI=http://localhost:4099/api/integrations/procore/callback
